{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": ["node", "express"]
  },
  "include": ["*.js", "ai", "middleware", "repositories", "routes", "services", "types"]
}
